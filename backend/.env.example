# Copier ce fichier en ".env" et adapter les valeurs
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=changer-cette-valeur-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# RG12 : pourcentage minimal de la moyenne des évaluations pour valider un module
SEUIL_REUSSITE=50
# Dossier de stockage des fichiers (ressources, travaux, attestations) et taille maximale en Mo
UPLOAD_DIR=uploads
TAILLE_MAX_FICHIER_MO=10
# Compte administrateur créé par "npm run db:seed"
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=Admin@12345
