/* ==========================================================================
   LMS Innov-T Learning Hub — Charte graphique violette (version 2)
   Inspiré du site innov-t.netlify.app : moderne, fluide, premium
   ========================================================================== */

:root {
  /* Palette violette complète */
  --v950: #150829; --v900: #2e1065; --v800: #4c1d95; --v700: #6d28d9;
  --v600: #7c3aed; --v500: #8b5cf6; --v400: #a78bfa; --v300: #c4b5fd;
  --v200: #ddd6fe; --v100: #ede9fe; --v50: #f5f3ff;

  /* Accents */
  --accent: #ec4899;
  --accent2: #f472b6;
  --accent3: #fb7185;
  --cyan: #06b6d4;

  /* Neutres */
  --ink: #1a1528;
  --ink-soft: #3d3455;
  --muted: #6b6485;
  --muted-light: #9b94b3;
  --line: #e7e3f4;
  --line-soft: #f0ecfa;
  --bg: #f6f4fc;
  --card: #ffffff;

  /* Sémantiques */
  --ok: #10b981; --ok-bg: #d1fae5; --ok-ink: #047857;
  --warn: #f59e0b; --warn-bg: #fef3c7; --warn-ink: #b45309;
  --bad: #ef4444; --bad-bg: #fee2e2; --bad-ink: #b91c1c;
  --info: #3b82f6; --info-bg: #dbeafe; --info-ink: #1d4ed8;

  /* Dégradés */
  --grad: linear-gradient(135deg, #7c3aed 0%, #ec4899 100%);
  --grad-2: linear-gradient(135deg, #6d28d9 0%, #8b5cf6 50%, #ec4899 100%);
  --grad-3: linear-gradient(120deg, #2e1065 0%, #6d28d9 50%, #ec4899 100%);
  --grad-soft: linear-gradient(135deg, #ede9fe, #fce7f3);
  --grad-glow: linear-gradient(135deg, rgba(124,58,237,.35), rgba(236,72,153,.35));

  /* Rayons */
  --radius: 16px;
  --radius-sm: 10px;
  --radius-lg: 22px;

  /* Ombres */
  --shadow-sm: 0 2px 10px -4px rgba(76, 29, 149, .25);
  --shadow: 0 12px 32px -14px rgba(76, 29, 149, .35);
  --shadow-lg: 0 24px 60px -20px rgba(76, 29, 149, .45);
  --shadow-glow: 0 0 0 6px rgba(124, 58, 237, .12);

  --sidebar: 268px;
  font-family: "Inter", "Outfit", "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg);
  background-image:
    radial-gradient(900px 500px at 100% -10%, rgba(139,92,246,.18), transparent 60%),
    radial-gradient(700px 400px at -10% 110%, rgba(236,72,153,.14), transparent 60%),
    radial-gradient(600px 300px at 50% 50%, rgba(6,182,212,.05), transparent 70%);
  min-height: 100vh;
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
}

h1, h2, h3, h4 { margin: 0; line-height: 1.15; letter-spacing: -.02em; font-weight: 800; }
p { margin: 0; }
a { color: var(--v700); text-decoration: none; transition: color .2s; }
a:hover { color: var(--accent); }
::selection { background: var(--v200); color: var(--v900); }

/* ---------- Scrollbar personnalisée ---------- */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: linear-gradient(180deg, var(--v400), var(--v600)); border-radius: 999px; border: 2px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, var(--v600), var(--accent)); }

/* ---------- Animations ---------- */
@keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes pop { from { opacity: 0; transform: scale(.94) translateY(8px); } to { opacity: 1; transform: none; } }
@keyframes slideIn { from { opacity: 0; transform: translateX(28px); } to { opacity: 1; transform: none; } }
@keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(28px, -32px) scale(1.1); } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes shimmer { from { background-position: -400px 0; } to { background-position: 400px 0; } }
@keyframes gradientMove { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
@keyframes pulseRing { 0% { box-shadow: 0 0 0 0 rgba(124,58,237,.45); } 70% { box-shadow: 0 0 0 14px rgba(124,58,237,0); } 100% { box-shadow: 0 0 0 0 rgba(124,58,237,0); } }
@keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
@keyframes shimmerText { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }
@keyframes borderGlow { 0%, 100% { box-shadow: 0 0 0 0 rgba(124,58,237,.4); } 50% { box-shadow: 0 0 0 8px rgba(124,58,237,0); } }

.anim { animation: fadeUp .55s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i, 0) * 70ms); }
.page { animation: fadeUp .45s cubic-bezier(.2,.7,.2,1) both; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-delay: 0ms !important; transition-duration: .01ms !important; }
}

/* ---------- Layout principal ---------- */
.app { display: flex; min-height: 100vh; }

.sidebar {
  position: fixed; inset: 0 auto 0 0; width: var(--sidebar); z-index: 40;
  display: flex; flex-direction: column; padding: 22px 14px; color: #e9e3ff;
  background:
    radial-gradient(500px 300px at 0% 0%, rgba(139,92,246,.5), transparent 60%),
    radial-gradient(400px 300px at 100% 100%, rgba(236,72,153,.3), transparent 60%),
    linear-gradient(180deg, var(--v950), var(--v900) 60%, var(--v800));
  transition: transform .3s ease;
  box-shadow: 4px 0 30px -10px rgba(27,10,58,.5);
}
.sidebar::before {
  content: ""; position: absolute; top: 0; right: 0; bottom: 0; width: 1px;
  background: linear-gradient(180deg, transparent, rgba(196,181,253,.3), transparent);
}

.brand { display: flex; align-items: center; gap: 12px; padding: 6px 10px 22px; position: relative; }
.brand::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: 10px; height: 1px; background: linear-gradient(90deg, transparent, rgba(196,181,253,.3), transparent); }
.brand img { width: 46px; height: 46px; border-radius: 14px; object-fit: cover; box-shadow: 0 0 0 2px rgba(255,255,255,.18), 0 8px 20px -6px rgba(124,58,237,.7); transition: transform .3s; }
.brand:hover img { transform: rotate(-6deg) scale(1.06); }
.brand strong { display: block; font-size: 17px; color: #fff; letter-spacing: -.02em; font-weight: 800; }
.brand span { font-size: 12px; color: var(--v300); letter-spacing: .02em; }

.nav { display: flex; flex-direction: column; gap: 4px; overflow-y: auto; padding-right: 4px; }
.nav::-webkit-scrollbar { width: 4px; }
.nav::-webkit-scrollbar-thumb { background: rgba(196,181,253,.3); }
.nav-titre { font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--v400); padding: 16px 12px 6px; font-weight: 700; }

.nav a {
  position: relative; display: flex; align-items: center; gap: 12px;
  padding: 11px 14px; border-radius: 12px; color: #d9d0f7;
  font-size: 14.5px; font-weight: 500; text-decoration: none;
  transition: background .2s, color .2s, transform .2s, padding-left .2s;
}
.nav a:hover { background: rgba(255,255,255,.08); color: #fff; transform: translateX(4px); padding-left: 18px; }
.nav a.actif {
  background: linear-gradient(90deg, rgba(139,92,246,.6), rgba(236,72,153,.25));
  color: #fff;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.12), 0 8px 20px -10px rgba(139,92,246,.8);
}
.nav a.actif::before {
  content: ""; position: absolute; left: -14px; top: 10px; bottom: 10px; width: 4px;
  border-radius: 0 4px 4px 0; background: var(--grad);
  box-shadow: 0 0 12px rgba(236,72,153,.6);
}
.nav a svg { transition: transform .25s; }
.nav a:hover svg, .nav a.actif svg { transform: scale(1.15); }

.sidebar-pied {
  margin-top: auto; padding: 14px; border-radius: 14px;
  background: linear-gradient(135deg, rgba(139,92,246,.2), rgba(236,72,153,.15));
  border: 1px solid rgba(196,181,253,.2);
  font-size: 12px; color: var(--v300); line-height: 1.5;
}

.contenu { margin-left: var(--sidebar); flex: 1; min-width: 0; display: flex; flex-direction: column; }

.topbar {
  position: sticky; top: 0; z-index: 30;
  display: flex; align-items: center; gap: 14px; justify-content: space-between;
  padding: 14px 32px;
  background: rgba(246,244,252,.75);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid rgba(231,227,244,.8);
}
.topbar .gauche { display: flex; align-items: center; gap: 12px; }

.btn.burger { display: none; }

.utilisateur-chip {
  display: flex; align-items: center; gap: 10px;
  padding: 5px 6px 5px 5px; border-radius: 999px;
  background: #fff; border: 1px solid var(--line);
  box-shadow: var(--shadow-sm);
  transition: box-shadow .2s, transform .2s;
}
.utilisateur-chip:hover { box-shadow: var(--shadow); transform: translateY(-1px); }
.utilisateur-chip .infos { line-height: 1.15; padding-right: 4px; }
.utilisateur-chip .infos b { display: block; font-size: 13.5px; }
.utilisateur-chip .infos small { color: var(--muted); font-size: 11.5px; text-transform: capitalize; }

main { padding: 30px 34px 60px; max-width: 1300px; width: 100%; margin: 0 auto; }

.voile { display: none; }

@media (max-width: 960px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.ouverte { transform: none; box-shadow: 0 0 80px rgba(0,0,0,.5); }
  .contenu { margin-left: 0; }
  .btn.burger { display: inline-flex; }
  main { padding: 20px 16px 40px; }
  .topbar { padding: 12px 16px; }
  .utilisateur-chip .infos { display: none; }
  .voile.visible { display: block; position: fixed; inset: 0; z-index: 35; background: rgba(27,10,58,.6); backdrop-filter: blur(4px); animation: fadeIn .2s both; }
}

/* ---------- Entêtes de page ---------- */
.entete { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 26px; }
.entete h1 {
  font-size: 30px; font-weight: 900; letter-spacing: -.03em;
  background: linear-gradient(120deg, var(--v900) 0%, var(--v600) 50%, var(--accent) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text; background-clip: text; color: transparent;
  animation: shimmerText 6s linear infinite;
}
.entete p { color: var(--muted); margin-top: 8px; font-size: 15px; }

/* ---------- Cartes ---------- */
.carte {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 22px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow .3s, transform .3s, border-color .3s;
  position: relative;
}
.carte.survol:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--v300);
}
.carte.survol::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, transparent, transparent);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor; mask-composite: exclude;
  opacity: 0; transition: opacity .3s;
}
.carte.survol:hover::before { background: var(--grad); opacity: 1; }
.carte h2 { font-size: 18px; margin-bottom: 4px; }

.grille-cartes { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
.grille-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px; }
.pile { display: flex; flex-direction: column; gap: 18px; }
.ligne { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.espace { flex: 1; }
.muted { color: var(--muted); } .petit { font-size: 13px; }
.titre-section {
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; text-transform: uppercase; letter-spacing: .12em;
  color: var(--muted); margin: 30px 0 14px; font-weight: 800;
}
.titre-section::after {
  content: ""; flex: 1; height: 1px;
  background: linear-gradient(90deg, var(--line), transparent);
}

/* ---------- Boutons ---------- */
.btn {
  --c: var(--v600);
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  border: 0; cursor: pointer; font: inherit; font-weight: 700; font-size: 14px;
  padding: 11px 18px; border-radius: 12px; color: #fff;
  background: var(--grad); background-size: 200% 200%;
  box-shadow: 0 8px 20px -8px rgba(124,58,237,.7);
  transition: transform .18s, box-shadow .18s, background-position .5s, filter .18s;
  position: relative; overflow: hidden;
}
.btn::before {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.25) 50%, transparent 70%);
  transform: translateX(-100%); transition: transform .6s;
}
.btn:hover:not(:disabled)::before { transform: translateX(100%); }
.btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 16px 28px -10px rgba(124,58,237,.8);
  background-position: 100% 50%;
}
.btn:active:not(:disabled) { transform: translateY(0) scale(.98); }
.btn:disabled { opacity: .55; cursor: not-allowed; }
.btn.secondaire { color: var(--v800); background: var(--v100); box-shadow: none; }
.btn.secondaire:hover:not(:disabled) { background: var(--v200); box-shadow: 0 6px 16px -6px rgba(124,58,237,.3); }
.btn.fantome { color: var(--v700); background: transparent; box-shadow: none; }
.btn.fantome:hover:not(:disabled) { background: var(--v50); box-shadow: none; color: var(--v600); }
.btn.danger { background: linear-gradient(135deg, #ef4444, #f97316); box-shadow: 0 8px 20px -8px rgba(239,68,68,.7); }
.btn.danger:hover:not(:disabled) { box-shadow: 0 14px 28px -10px rgba(239,68,68,.85); }
.btn.petit { padding: 7px 12px; font-size: 13px; border-radius: 10px; }
.btn.icone { padding: 9px; border-radius: 10px; }

.chargement {
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,.4); border-top-color: #fff;
  animation: spin .7s linear infinite;
}
.secondaire .chargement, .fantome .chargement { border-color: var(--v200); border-top-color: var(--v600); }

/* ---------- Champs de formulaire ---------- */
.champ { display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; font-weight: 600; color: #3b3355; }
.champ input, .champ select, .champ textarea {
  font: inherit; font-weight: 400; color: var(--ink);
  padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 12px;
  background: #fff; outline: none; width: 100%;
  transition: border-color .2s, box-shadow .2s, transform .15s;
}
.champ textarea { min-height: 96px; resize: vertical; font-family: inherit; }
.champ input:hover, .champ select:hover, .champ textarea:hover { border-color: var(--v300); }
.champ input:focus, .champ select:focus, .champ textarea:focus {
  border-color: var(--v500);
  box-shadow: 0 0 0 4px rgba(139,92,246,.18);
}
.champ .avec-icone { position: relative; }
.champ .avec-icone svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--v400); pointer-events: none; }
.champ .avec-icone input { padding-left: 42px; }
.champ .oeil { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: 0; background: none; color: var(--muted); cursor: pointer; padding: 6px; display: flex; border-radius: 8px; }
.champ .oeil:hover { background: var(--v50); color: var(--v600); }

.grille-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }

.cases { display: flex; gap: 10px; flex-wrap: wrap; }
.case {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 14px; border: 1.5px solid var(--line); border-radius: 999px;
  cursor: pointer; font-size: 14px; font-weight: 500; transition: all .2s; user-select: none;
  text-transform: capitalize;
}
.case input { display: none; }
.case:hover { border-color: var(--v300); background: var(--v50); }
.case.active { border-color: var(--v500); background: var(--v50); color: var(--v800); box-shadow: 0 0 0 3px rgba(139,92,246,.15); }

.recherche { position: relative; min-width: 260px; }
.recherche svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--v400); }
.recherche input {
  width: 100%; padding: 11px 14px 11px 40px;
  border: 1.5px solid var(--line); border-radius: 12px;
  font: inherit; outline: none; background: #fff;
  transition: border-color .2s, box-shadow .2s;
}
.recherche input:focus { border-color: var(--v500); box-shadow: 0 0 0 4px rgba(139,92,246,.18); }

/* ---------- Badges, avatars ---------- */
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 11px; border-radius: 999px; font-size: 12px; font-weight: 700;
  text-transform: capitalize; white-space: nowrap;
  background: var(--v100); color: var(--v800);
}
.badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.badge.ok { background: var(--ok-bg); color: var(--ok-ink); }
.badge.warn { background: var(--warn-bg); color: var(--warn-ink); }
.badge.bad { background: var(--bad-bg); color: var(--bad-ink); }
.badge.info { background: var(--info-bg); color: var(--info-ink); }
.badge.neutre { background: #ece9f5; color: #5b5478; }

.avatar {
  display: inline-flex; align-items: center; justify-content: center; flex: none;
  width: 38px; height: 38px; border-radius: 50%; color: #fff;
  font-weight: 800; font-size: 13px; text-transform: uppercase;
  background: var(--grad); box-shadow: 0 4px 12px -4px rgba(124,58,237,.6);
  transition: transform .25s;
}
.avatar:hover { transform: scale(1.08) rotate(-4deg); }
.avatar.grand { width: 54px; height: 54px; font-size: 18px; }

/* ---------- Statistiques (Dashboard) ---------- */
.stat {
  position: relative; overflow: hidden;
  display: flex; align-items: center; gap: 16px;
}
.stat .pastille {
  flex: none; width: 56px; height: 56px; border-radius: 16px;
  display: flex; align-items: center; justify-content: center; color: #fff;
  background: var(--grad); box-shadow: 0 12px 24px -10px rgba(124,58,237,.75);
  transition: transform .3s;
}
.stat:hover .pastille { transform: scale(1.08) rotate(-6deg); }
.stat .valeur { font-size: 32px; font-weight: 900; line-height: 1; letter-spacing: -.04em; }
.stat .etiquette { color: var(--muted); font-size: 13.5px; margin-top: 6px; }
.stat::after {
  content: ""; position: absolute; right: -30px; top: -30px;
  width: 120px; height: 120px; border-radius: 50%;
  background: var(--grad-soft); opacity: .8; z-index: 0;
  transition: transform .5s;
}
.stat:hover::after { transform: scale(1.2); }
.stat > * { position: relative; z-index: 1; }

/* ---------- Tableaux ---------- */
.tableau-cadre {
  overflow-x: auto; border: 1px solid var(--line);
  border-radius: var(--radius); background: #fff;
  box-shadow: var(--shadow-sm);
}
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th {
  text-align: left; padding: 14px 16px;
  font-size: 11.5px; text-transform: uppercase; letter-spacing: .1em;
  color: var(--muted); background: #faf8ff; border-bottom: 1px solid var(--line);
  white-space: nowrap; font-weight: 800;
}
td { padding: 14px 16px; border-bottom: 1px solid var(--line-soft); vertical-align: middle; }
tbody tr { transition: background .15s; animation: fadeUp .4s both; animation-delay: calc(var(--i, 0) * 35ms); }
tbody tr:hover { background: linear-gradient(90deg, #faf8ff, #fdf4ff); }
tbody tr:last-child td { border-bottom: 0; }
.cellule-nom { display: flex; align-items: center; gap: 12px; }
.cellule-nom b { display: block; }
.cellule-nom small { color: var(--muted); font-size: 12.5px; }

/* ---------- Barre de progression ---------- */
.barre { height: 10px; border-radius: 999px; background: var(--v100); overflow: hidden; min-width: 90px; }
.barre > i {
  display: block; height: 100%; width: 0; border-radius: inherit;
  background: var(--grad); background-size: 200% 100%;
  transition: width 1.2s cubic-bezier(.2,.8,.2,1);
  animation: gradientMove 4s ease infinite;
}
.barre.ok > i { background: linear-gradient(90deg, #10b981, #34d399); }
.progression { display: flex; align-items: center; gap: 10px; }
.progression b { min-width: 46px; font-size: 13px; font-weight: 700; }

.anneau { position: relative; display: inline-flex; align-items: center; justify-content: center; }
.anneau svg { transform: rotate(-90deg); }
.anneau .fond { stroke: var(--v100); }
.anneau .valeur-anneau { stroke: url(#degradeAnneau); stroke-linecap: round; transition: stroke-dashoffset 1.4s cubic-bezier(.2,.8,.2,1); }
.anneau span { position: absolute; font-weight: 900; letter-spacing: -.03em; }

/* ---------- États vides, chargement ---------- */
.vide { text-align: center; padding: 50px 20px; color: var(--muted); }
.vide .rond {
  width: 80px; height: 80px; margin: 0 auto 16px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--grad-soft); color: var(--v600);
  animation: pulseRing 2.4s infinite;
}
.vide h3 { color: var(--ink); margin-bottom: 8px; font-size: 18px; font-weight: 800; }
.squelette {
  border-radius: 12px;
  background: linear-gradient(90deg, #eeeaf8 25%, #f8f6fd 37%, #eeeaf8 63%);
  background-size: 800px 100%; animation: shimmer 1.3s linear infinite;
}

/* ---------- Fenêtres modales et notifications ---------- */
.fond-modal {
  position: fixed; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center; padding: 20px;
  background: rgba(27,10,58,.6); backdrop-filter: blur(8px);
  animation: fadeIn .2s both;
}
.modal {
  width: 100%; max-width: 560px; max-height: 92vh; overflow: auto;
  background: #fff; border-radius: 22px;
  box-shadow: 0 30px 90px -20px rgba(27,10,58,.7), 0 0 0 1px rgba(196,181,253,.3);
  animation: pop .35s cubic-bezier(.2,.8,.2,1) both;
}
.modal.large { max-width: 880px; }
.modal-entete { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 22px 26px; border-bottom: 1px solid var(--line); }
.modal-entete h2 { font-size: 20px; }
.modal-corps { padding: 24px 26px; }
.modal-pied { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 26px 24px; }

.toasts { position: fixed; top: 18px; right: 18px; z-index: 200; display: flex; flex-direction: column; gap: 10px; width: min(380px, calc(100vw - 36px)); }
.toast {
  display: flex; gap: 12px; align-items: flex-start;
  padding: 14px 18px; border-radius: 14px;
  background: #fff; border: 1px solid var(--line);
  box-shadow: var(--shadow-lg);
  animation: slideIn .35s cubic-bezier(.2,.8,.2,1) both;
  border-left: 5px solid var(--v500);
}
.toast.ok { border-left-color: var(--ok); }
.toast.bad { border-left-color: var(--bad); }
.toast svg { flex: none; margin-top: 1px; }
.toast.ok svg { color: var(--ok); }
.toast.bad svg { color: var(--bad); }
.toast p { font-size: 14px; line-height: 1.45; font-weight: 500; }

.confirm-icone {
  width: 58px; height: 58px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 16px; background: var(--bad-bg); color: var(--bad);
  animation: pulseRing 2s infinite;
}
.confirm-icone.neutre { background: var(--v100); color: var(--v700); }

/* ---------- Dépôt de fichier ---------- */
.depot {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  padding: 26px; text-align: center;
  border: 2px dashed var(--v300); border-radius: 16px;
  background: var(--v50); color: var(--v800); cursor: pointer;
  transition: all .25s;
}
.depot:hover, .depot.survol {
  border-color: var(--v600); background: var(--v100);
  transform: scale(1.01);
  box-shadow: 0 12px 30px -12px rgba(124,58,237,.5);
}
.depot input { display: none; }
.depot small { color: var(--muted); }

/* ---------- Onglets, accordéons, listes ---------- */
.onglets {
  display: inline-flex; gap: 4px; padding: 5px;
  border-radius: 14px; background: #fff; border: 1px solid var(--line);
  box-shadow: var(--shadow-sm); flex-wrap: wrap;
}
.onglet {
  border: 0; background: transparent; font: inherit; font-weight: 700;
  font-size: 14px; padding: 9px 18px; border-radius: 10px;
  color: var(--muted); cursor: pointer;
  transition: all .2s; display: inline-flex; gap: 8px; align-items: center;
}
.onglet:hover { color: var(--v700); background: var(--v50); }
.onglet.actif { background: var(--grad); color: #fff; box-shadow: 0 8px 18px -8px rgba(124,58,237,.7); }
.onglet .nombre { background: rgba(255,255,255,.25); border-radius: 999px; padding: 1px 9px; font-size: 12px; }
.onglet:not(.actif) .nombre { background: var(--v100); color: var(--v700); }

.accordeon {
  border: 1px solid var(--line); border-radius: var(--radius);
  background: #fff; overflow: hidden; box-shadow: var(--shadow-sm);
  transition: box-shadow .3s, border-color .3s;
}
.accordeon:hover { border-color: var(--v300); box-shadow: var(--shadow); }
.accordeon > button {
  width: 100%; display: flex; align-items: center; gap: 14px;
  padding: 18px 22px; border: 0; background: transparent; font: inherit;
  cursor: pointer; text-align: left;
}
.accordeon > button:hover { background: #faf8ff; }
.accordeon .chevron { transition: transform .3s; color: var(--v500); }
.accordeon.ouvert .chevron { transform: rotate(180deg); }
.accordeon .corps { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
.accordeon.ouvert .corps { grid-template-rows: 1fr; }
.accordeon .corps > div { overflow: hidden; }
.accordeon .corps-interne { padding: 4px 22px 22px; }

.liste-ligne {
  display: flex; align-items: center; gap: 12px;
  padding: 13px 16px; border: 1px solid var(--line);
  border-radius: 12px; background: #fff;
  transition: border-color .2s, transform .2s, box-shadow .2s;
}
.liste-ligne:hover {
  border-color: var(--v300);
  transform: translateX(4px);
  box-shadow: 0 8px 20px -10px rgba(124,58,237,.35);
}

.puces { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.puce {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 6px 4px 11px; border-radius: 999px;
  background: var(--v100); color: var(--v800);
  font-size: 12.5px; font-weight: 700;
}
.puce button {
  border: 0; background: rgba(109,40,217,.15); color: var(--v800);
  width: 18px; height: 18px; border-radius: 50%; cursor: pointer;
  display: flex; align-items: center; justify-content: center; padding: 0;
  transition: all .15s;
}
.puce button:hover { background: var(--v700); color: #fff; }

.lien-btn {
  border: 0; background: none; padding: 0; font: inherit;
  color: var(--v700); cursor: pointer;
  display: inline-flex; align-items: center; gap: 6px; font-weight: 700;
  transition: color .2s;
}
.lien-btn:hover { color: var(--accent); text-decoration: underline; }

.fil { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 14px; margin-bottom: 14px; }

/* ---------- Page de connexion (hero) ---------- */
.connexion { display: grid; grid-template-columns: 1.1fr 1fr; min-height: 100vh; }

.connexion-hero {
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; justify-content: center;
  padding: 60px; color: #fff;
  background: linear-gradient(130deg, #150829, #2e1065, #6d28d9, #ec4899);
  background-size: 400% 400%;
  animation: gradientMove 16s ease infinite;
}
.blob {
  position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55;
  animation: float 10s ease-in-out infinite;
}
.blob.b1 { width: 340px; height: 340px; background: #a78bfa; top: -80px; right: -60px; }
.blob.b2 { width: 280px; height: 280px; background: #f472b6; bottom: -60px; left: 8%; animation-delay: -3s; }
.blob.b3 { width: 200px; height: 200px; background: #06b6d4; top: 42%; left: 52%; animation-delay: -6s; opacity: .4; }
.connexion-hero > * { position: relative; z-index: 1; }

.connexion-hero .logo {
  width: 100px; height: 100px; border-radius: 26px; object-fit: cover;
  box-shadow: 0 24px 48px -14px rgba(0,0,0,.6), 0 0 0 4px rgba(255,255,255,.2);
  animation: fadeUp .7s both, floatY 4s ease-in-out infinite 1s;
}
.connexion-hero h1 {
  font-size: 48px; font-weight: 900;
  margin: 32px 0 16px; letter-spacing: -.04em; line-height: 1.05;
  animation: fadeUp .7s .1s both;
}
.connexion-hero p {
  font-size: 17px; max-width: 480px; color: #ece6ff;
  line-height: 1.65; animation: fadeUp .7s .2s both;
}
.atouts { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
.atout {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 18px; border-radius: 999px;
  background: rgba(255,255,255,.14);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.25);
  font-size: 14px; font-weight: 700;
  animation: fadeUp .6s both;
  animation-delay: calc(.35s + var(--i) * .1s);
  transition: transform .25s, background .25s;
}
.atout:hover { transform: translateY(-3px); background: rgba(255,255,255,.22); }

.connexion-formulaire { display: flex; align-items: center; justify-content: center; padding: 40px 24px; background: #fff; }
.connexion-boite { width: 100%; max-width: 400px; animation: fadeUp .6s .15s both; }
.connexion-boite h2 { font-size: 32px; font-weight: 900; letter-spacing: -.03em; }
.connexion-boite .sous-titre { color: var(--muted); margin: 10px 0 32px; font-size: 15px; }

.erreur-formulaire {
  display: flex; gap: 10px; align-items: center;
  padding: 13px 16px; border-radius: 12px;
  background: var(--bad-bg); color: var(--bad-ink);
  font-size: 14px; font-weight: 500;
  animation: pop .25s both;
}

@media (max-width: 900px) {
  .connexion { grid-template-columns: 1fr; }
  .connexion-hero { padding: 36px 26px 44px; }
  .connexion-hero h1 { font-size: 34px; margin-top: 20px; }
  .connexion-hero .logo { width: 68px; height: 68px; border-radius: 20px; }
  .atouts { display: none; }
}

/* ---------- Hero d'accueil ---------- */
.hero-accueil {
  position: relative; overflow: hidden; margin-bottom: 30px;
  padding: 34px 36px; border-radius: 24px; color: #fff;
  background: linear-gradient(120deg, #2e1065, #6d28d9 55%, #ec4899);
  background-size: 250% 250%;
  animation: gradientMove 14s ease infinite, fadeUp .5s both;
  box-shadow: var(--shadow-lg);
}
.hero-accueil h1 { font-size: 30px; font-weight: 900; letter-spacing: -.03em; }
.hero-accueil p { margin-top: 10px; color: #ede9fe; max-width: 600px; font-size: 15px; line-height: 1.6; }
.hero-accueil .blob { opacity: .35; }
.hero-accueil > * { position: relative; z-index: 1; }

.raccourci {
  display: flex; align-items: center; gap: 14px;
  text-decoration: none !important; color: inherit;
}
.raccourci .pastille {
  flex: none; width: 48px; height: 48px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  background: var(--v100); color: var(--v700);
  transition: all .3s cubic-bezier(.2,.8,.2,1);
}
.raccourci:hover .pastille {
  background: var(--grad); color: #fff;
  transform: rotate(-8deg) scale(1.1);
  box-shadow: 0 10px 24px -8px rgba(124,58,237,.7);
}
.raccourci b { display: block; }
.raccourci small { color: var(--muted); }

.separateur { height: 1px; background: var(--line); margin: 18px 0; }

.kpi-mini { display: flex; gap: 18px; flex-wrap: wrap; margin: 12px 0 16px; }
.kpi-mini div { font-size: 13px; color: var(--muted); }
.kpi-mini b { display: block; font-size: 17px; color: var(--ink); font-weight: 800; }